# Copy to .env and configure for your environment

APP_NAME="EVSU Reserve"
APP_ENV=local

# mail = PHP mail(), smtp = PHPMailer SMTP, log = storage/logs/mail.log (local dev)
MAIL_DRIVER=log
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@evsu.edu.ph
MAIL_FROM_NAME="EVSU Reserve"
